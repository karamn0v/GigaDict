<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.9</Version>
    <AssemblyName>GigaDict</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gigadict.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/gigadict.ico" LogicalName="GigaDict.App.gigadict.ico" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <ProjectReference Include="../GigaDict.Core/GigaDict.Core.csproj" />
    <ProjectReference Include="../GigaDict.Recognition/GigaDict.Recognition.csproj" />
    <ProjectReference Include="../GigaDict.Audio/GigaDict.Audio.csproj" />
    <ProjectReference Include="../GigaDict.Input/GigaDict.Input.csproj" />
  </ItemGroup>

</Project>
